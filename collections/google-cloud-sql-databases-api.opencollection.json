              "accessTokenUrl": "https://oauth2.googleapis.com/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieves a resource containing information about a database inside a Cloud SQL instance."
