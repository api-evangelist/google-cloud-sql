        {
          "info": {
            "name": "Google Cloud SQL Delete a database",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://sqladmin.googleapis.com/v1/projects/:project/instances/:instance/databases/:database",
